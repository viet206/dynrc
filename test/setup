#!/bin/sh

OPT=$1
CC=gcc
SRC="../src/core/*.c ../src/compat/*.c ../src/hal/*.c -I../src"
FLAGS="-O3 -shared -fPIC"
TARGET="libdyn.so"

case $OPT in
	build)
		$CC $SRC $FLAGS -o $TARGET
		;;
	install)
		mkdir dynrc
		mkdir dynrc/core
		mkdir dynrc/hal
		mkdir dynrc/compat
		
		cp ../src/core/*.h dynrc/core
		cp ../src/hal/*.h dynrc/hal
		cp ../src/compat/*.h dynrc/compat

		mv dynrc $INCLUDE_DIR
		mv $TARGET $LIB_DIR
		
		;;
	delete)
		rm -rf $INCLUDE_DIR/dynrc
		rm -rf $LIB_DIR/dynrc
		;;
	*)
		;;
esac
